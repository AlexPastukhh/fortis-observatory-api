# OWNAPI-01 CANDIDATE ONLY — NOT THE HISTORICAL DOCKERFILE.
# Build must provide a separately verified, immutable base image reference:
#   --build-arg BASE_IMAGE=python@sha256:<verified platform-specific manifest digest>
# No default: deliberately prevents accidental build with an unpinned tag.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

# Five byte-for-byte recovered Python files. CI must verify SOURCE-MANIFEST first.
COPY --chown=1000:1000 gateway.py provision.py store.py repo_messages.py repo_pending.py ./

USER 1000:1000
EXPOSE 18756
ENTRYPOINT ["python3", "/app/gateway.py"]

# Deliberately no CMD. In an authorized isolated deployment, supply all four
# required paths: --archive, --pending-root, --receipts, --clients, plus bind/port.
# Never copy clients.json or runtime tokens into this image.
